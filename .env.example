PORT=5000
API_KEY=your_2factor_api_key
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Startup Submit Pool 2026 <onboarding@resend.dev>
ADMIN_EMAIL=contact@itechnebula.com

# PostgreSQL — required so Startup Registration IDs survive server restarts
# (used by the Shortlisted Startup form to verify an ID). Get this from your
# Postgres provider (e.g. Render Postgres → Internal/External Database URL).
DATABASE_URL=postgresql://user:password@host:5432/dbname
